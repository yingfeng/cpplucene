export module lucene_core:query_parser_base;

import :analyzer;
import :boolean_clause;
import :bytes_ref;
import :error;
import :multi_term_query;
import :occur;
import :query;
import :query_builder;
import :query_parser_token;
import :term;
import :types;

import std;

namespace lucene {

/// The default operator between clauses.
export enum class QueryParserOperator : uint8_t {
    /// `a b` means `a OR b` (the default).
    kOr,
    /// `a b` means `a AND b`.
    kAnd,
};

/// The conjunction that introduced a clause (`AND`/`OR`/nothing).
export enum class Conjunction : uint8_t { kNone, kAnd, kOr };

/// The `+`/`-`/`NOT` modifier of a clause.
export enum class Modifier : uint8_t { kNone, kRequired, kNot };

/// Turns syntax trees into queries: the half of the classic query parser that
/// is not generated by JavaCC.
///
/// Port of `QueryParserBase` (`queryparser/classic/query_parser_base.rs` plus the
/// actions of `QueryParser.jj`).  [`QueryParser`](lucene_core:query_parser) owns
/// the recursion over the syntax; this class owns the token and clause handling:
/// which query a bare token becomes, how a range is opened, how `^2` boosts, and
/// how clauses are added to a boolean query.
///
/// **Deviations** from the reference implementation:
///
/// 1. There is no date support: `[6/1/2005 TO 6/4/2005]` is treated as a plain
///    term range instead of being formatted through `DateTools` first, because
///    `DateTools` is not ported.  Override [`get_range_query`] to plug dates in.
/// 2. [`normalize`] runs the field's analysis chain and keeps the token when it
///    produced exactly one; the reference implementation wraps the chain in a
///    keyword tokenizer (`NormalizingTokenStream`) so that the term is never
///    split.  For the analyzers in this port the two agree on single-token
///    normalization (case folding, accent folding, …), which is what wildcard,
///    prefix, fuzzy and range boundaries need.
/// 3. `QueryParserUtil` (`parse`, `parseMultipleFields`) is not ported; build one
///    parser per field and combine the queries yourself.
export class QueryParserBase : public QueryBuilder {
public:
    explicit QueryParserBase(Analyzer &analyzer);
    ~QueryParserBase() override = default;

    // ---- configuration ----

    /// The field used for terms that do not name one.
    void set_field(std::string field) { field_ = std::move(field); }
    [[nodiscard]] const std::string &field() const noexcept { return field_; }

    void set_default_operator(QueryParserOperator value) noexcept { default_operator_ = value; }
    [[nodiscard]] QueryParserOperator default_operator() const noexcept { return default_operator_; }

    /// The slop a quoted phrase gets when it does not say `"a b"~n`.  Default `0`.
    void set_phrase_slop(int32_t value) noexcept { phrase_slop_ = value; }
    [[nodiscard]] int32_t phrase_slop() const noexcept { return phrase_slop_; }

    /// The similarity a fuzzy term gets when it does not say `term~n`.  Default
    /// `0.5`, like the reference implementation.
    void set_fuzzy_min_sim(float value) noexcept { fuzzy_min_sim_ = value; }
    [[nodiscard]] float fuzzy_min_sim() const noexcept { return fuzzy_min_sim_; }

    /// How many leading characters a fuzzy term must share.  Default `0`.
    void set_fuzzy_prefix_length(int32_t value) noexcept { fuzzy_prefix_length_ = value; }
    [[nodiscard]] int32_t fuzzy_prefix_length() const noexcept { return fuzzy_prefix_length_; }

    /// Whether `*foo` and `?foo` are allowed.  Default `false`.
    void set_allow_leading_wildcard(bool value) noexcept { allow_leading_wildcard_ = value; }
    [[nodiscard]] bool allow_leading_wildcard() const noexcept { return allow_leading_wildcard_; }

    /// Whether bare terms are turned into phrases.  Default `false`.
    void set_auto_generate_phrase_queries(bool value) noexcept { auto_generate_phrase_queries_ = value; }
    [[nodiscard]] bool auto_generate_phrase_queries() const noexcept { return auto_generate_phrase_queries_; }

    /// The work limit of the automaton determinization.  Default
    /// `Operations::DEFAULT_DETERMINIZE_WORK_LIMIT`.
    void set_determinize_work_limit(int32_t value) noexcept { determinize_work_limit_ = value; }
    [[nodiscard]] int32_t determinize_work_limit() const noexcept { return determinize_work_limit_; }

    /// The rewrite method multi-term queries are built with.
    void set_multi_term_rewrite_method(MultiTermRewriteMethod value) noexcept {
        multi_term_rewrite_method_ = value;
    }
    [[nodiscard]] const MultiTermRewriteMethod &multi_term_rewrite_method() const noexcept {
        return multi_term_rewrite_method_;
    }

    /// Whether the query text is split on whitespace before it reaches the
    /// analyzer.  Default `false`, which hands the whole run of terms to the
    /// analyzer (this is what makes `机器 学习` analyze as one text).
    ///
    /// Setting this to `false` while [`auto_generate_phrase_queries`] is on is
    /// rejected, like the reference implementation does.
    [[nodiscard]] VoidResult set_split_on_whitespace(bool value);
    [[nodiscard]] bool split_on_whitespace() const noexcept { return split_on_whitespace_; }

    /// Escapes every character the classic syntax gives a meaning, so that `text`
    /// is parsed as one literal term.
    [[nodiscard]] static std::string escape(std::string_view text);

protected:
    // ---- query construction, one method per syntax production ----

    /// Analyzes `query_text`; `quoted` makes phrases out of several positions.
    [[nodiscard]] virtual Result<std::shared_ptr<Query>> get_field_query(std::string_view field,
                                                                        std::string_view query_text, bool quoted);

    /// [`get_field_query`], then re-slopped when the result is a phrase.
    ///
    /// Named differently from the reference implementation's overload so that a
    /// call with a literal `0` cannot pick the wrong one.
    [[nodiscard]] virtual Result<std::shared_ptr<Query>> get_field_query_with_slop(std::string_view field,
                                                                                  std::string_view query_text,
                                                                                  int32_t slop);

    /// A range query.  `part1`/`part2` are the (already unescaped) bounds, an
    /// empty optional meaning an open end.  The bounds are normalized through the
    /// analyzer.
    [[nodiscard]] virtual Result<std::shared_ptr<Query>> get_range_query(std::string_view field,
                                                                        std::optional<std::string> part1,
                                                                        std::optional<std::string> part2,
                                                                        bool start_inclusive, bool end_inclusive);

    /// A prefix query; `term_str` does not contain the trailing `*`.
    [[nodiscard]] virtual Result<std::shared_ptr<Query>> get_prefix_query(std::string_view field,
                                                                         std::string_view term_str);

    /// A wildcard query; `term_str` still holds `*` and `?`.
    [[nodiscard]] virtual Result<std::shared_ptr<Query>> get_wildcard_query(std::string_view field,
                                                                           std::string_view term_str);

    /// A regular expression query; `term_str` is the text between the slashes.
    [[nodiscard]] virtual Result<std::shared_ptr<Query>> get_regexp_query(std::string_view field,
                                                                         std::string_view term_str);

    /// A fuzzy query with `min_similarity` in `[0, 1]`.
    [[nodiscard]] virtual Result<std::shared_ptr<Query>> get_fuzzy_query(std::string_view field,
                                                                        std::string_view term_str,
                                                                        float min_similarity);

    /// A boolean query out of `clauses`; a null pointer when there is no clause
    /// left (every term was filtered away by the analyzer).
    [[nodiscard]] virtual Result<std::shared_ptr<Query>> get_boolean_query(std::vector<BooleanClause> clauses);

    // ---- hooks for the concrete query objects ----

    [[nodiscard]] virtual Result<std::shared_ptr<Query>> new_prefix_query(const Term &prefix);
    [[nodiscard]] virtual Result<std::shared_ptr<Query>> new_wildcard_query(const Term &wildcard);
    [[nodiscard]] virtual Result<std::shared_ptr<Query>> new_regexp_query(const Term &regexp);
    [[nodiscard]] virtual Result<std::shared_ptr<Query>> new_fuzzy_query(const Term &term, float min_similarity,
                                                                        int32_t prefix_length);
    [[nodiscard]] virtual Result<std::shared_ptr<Query>> new_range_query(std::string field,
                                                                        std::optional<BytesRef> lower_term,
                                                                        std::optional<BytesRef> upper_term,
                                                                        bool include_lower, bool include_upper);
    [[nodiscard]] virtual std::shared_ptr<Query> new_match_all_docs_query();
    [[nodiscard]] virtual BooleanClause new_boolean_clause(std::shared_ptr<Query> query, Occur occur);

    // ---- clause plumbing, shared with the parser ----

    /// Adds `q` to `clauses`, applying `conj` (which may turn the previous clause
    /// into a `MUST`) and `mods`, and the default operator.
    [[nodiscard]] VoidResult add_clause(std::vector<BooleanClause> &clauses, Conjunction conj, Modifier mods,
                                        std::shared_ptr<Query> q);

    /// Adds a query produced from a whitespace-separated run of terms, flattening
    /// it when every nested clause is a term query.
    [[nodiscard]] VoidResult add_multi_term_clauses(std::vector<BooleanClause> &clauses, std::shared_ptr<Query> q);

    // ---- token handling, shared with the parser ----

    /// Turns a bare token (a term, wildcard, prefix, regexp or fuzzy term) into a
    /// query.
    [[nodiscard]] Result<std::shared_ptr<Query>> handle_bare_token_query(std::string_view field,
                                                                       const QueryToken &term,
                                                                       const QueryToken *fuzzy_slop, bool prefix,
                                                                       bool wildcard, bool fuzzy, bool regexp);

    /// Turns a quoted token (`"a b"`, with an optional `~n`) into a phrase query.
    [[nodiscard]] Result<std::shared_ptr<Query>> handle_quoted_term(std::string_view field, const QueryToken &term,
                                                                   const QueryToken *fuzzy_slop);

    /// Applies a `^n` boost to `q` (a null query is left alone).
    [[nodiscard]] Result<std::shared_ptr<Query>> handle_boost(std::shared_ptr<Query> q, const QueryToken *boost);

    /// The similarity of a `~n` suffix, or [`fuzzy_min_sim`] when it has none.
    [[nodiscard]] float get_fuzzy_distance(const QueryToken &fuzzy_token) const;

    /// Normalizes `text` through the field's analysis chain (see the class notes
    /// for the deviation).
    [[nodiscard]] Result<BytesRef> normalize(std::string_view field, std::string_view text);

    /// [`normalize`] applied to the literal chunks of a wildcard pattern, leaving
    /// the wildcards and the escaped characters untouched.
    [[nodiscard]] Result<std::string> analyze_wildcard(std::string_view field, std::string_view term_str);

private:
    std::string field_;
    QueryParserOperator default_operator_{QueryParserOperator::kOr};
    int32_t phrase_slop_{0};
    float fuzzy_min_sim_{0.5F};
    int32_t fuzzy_prefix_length_{0};
    bool allow_leading_wildcard_{false};
    bool auto_generate_phrase_queries_{false};
    int32_t determinize_work_limit_{1024};
    bool split_on_whitespace_{false};
    MultiTermRewriteMethod multi_term_rewrite_method_{MultiTermRewriteMethod::kConstantScore};
};

} // namespace lucene
